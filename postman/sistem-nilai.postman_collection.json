          "request": {"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"client_id\": \"{{serviceClientId}}\",\n  \"client_secret\": \"{{serviceClientSecret}}\"\n}","options":{"raw":{"language":"json"}}},"url":"{{base}}/auth/service"}
