{
  "info": {
    "_postman_id": "4bd512b1-6720-4ed1-87bd-13ecb8180001",
    "name": "Sistem Nilai Zero Trust - 14 Skenario",
    "description": "Collection demo sesuai role, endpoint, dan data seed. Jalankan berurutan dari skenario 01 sampai 14. Sebelum menjalankan, aktifkan tiga service, salin .env.example ke .env, dan samakan serviceClientSecret pada environment ini dengan SERVICE_CLIENT_SECRET. Request update/finalisasi hanya allow selama JAM_MULAI sampai sebelum JAM_SELESAI.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Skenario 01 - Login mahasiswa valid",
      "item": [
        {
          "name": "[ALLOW] Login mhs1 dengan device terdaftar",
          "event": [{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Login berhasil', function () { pm.response.to.have.status(200); });","const data = pm.response.json();","pm.environment.set('mhs1AccessToken', data.access_token);","pm.environment.set('mhs1RefreshToken', data.refresh_token);","pm.test('Token access dan refresh tersedia', function () { pm.expect(data.access_token).to.be.a('string'); pm.expect(data.refresh_token).to.be.a('string'); });"]}}],
          "request": {"method":"POST","header":[{"key":"X-Device-ID","value":"{{deviceMhs1}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"username\": \"{{usernameMhs1}}\",\n  \"password\": \"{{passwordMhs1}}\"\n}","options":{"raw":{"language":"json"}}},"url":"{{base}}/auth/login"}
        }
      ]
    },
    {
      "name": "Skenario 02 - Kredensial atau device salah",
      "item": [
        {
          "name": "[DENY] Login mhs1 dengan password salah",
          "event": [{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Password salah ditolak', function () { pm.response.to.have.status(401); });"]}}],
          "request": {"method":"POST","header":[{"key":"X-Device-ID","value":"{{deviceMhs1}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"username\": \"{{usernameMhs1}}\",\n  \"password\": \"password-salah\"\n}","options":{"raw":{"language":"json"}}},"url":"{{base}}/auth/login"}
        },
        {
          "name": "[DENY] Login mhs1 dari device tidak terdaftar",
          "event": [{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Device tidak terdaftar ditolak', function () { pm.response.to.have.status(401); });"]}}],
          "request": {"method":"POST","header":[{"key":"X-Device-ID","value":"DEV-TIDAK-TERDAFTAR"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"username\": \"{{usernameMhs1}}\",\n  \"password\": \"{{passwordMhs1}}\"\n}","options":{"raw":{"language":"json"}}},"url":"{{base}}/auth/login"}
        }
      ]
    },
    {
      "name": "Skenario 03 - Mahasiswa melihat nilai sendiri",
      "item": [
        {
          "name": "[ALLOW] GET nilai milik mhs1 dan simpan ID nilai seed",
          "event": [{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Nilai sendiri diizinkan', function () { pm.response.to.have.status(200); });","const data = pm.response.json().data;","pm.test('Semua nilai hanya untuk NIM sendiri', function () { pm.expect(data.length).to.be.above(0); data.forEach(function (item) { pm.expect(item.nim).to.eql(pm.environment.get('nimMhs1')); }); });","const if101 = data.find(function (item) { return item.kelas_id === pm.environment.get('kelasIF101'); });","const if202 = data.find(function (item) { return item.kelas_id === pm.environment.get('kelasIF202'); });","pm.test('ID nilai seed berhasil ditemukan secara dinamis', function () { pm.expect(if101).to.exist; pm.expect(if202).to.exist; });","pm.environment.set('nilaiMhs1IF101', String(if101.id));","pm.environment.set('nilaiMhs1IF202', String(if202.id));"]}}],
          "request": {"method":"GET","header":[{"key":"Authorization","value":"Bearer {{mhs1AccessToken}}"},{"key":"X-Device-ID","value":"{{deviceMhs1}}"}],"url":"{{base}}/nilai"}
        }
      ]
    },
    {
      "name": "Skenario 04 - Transkrip milik mahasiswa",
