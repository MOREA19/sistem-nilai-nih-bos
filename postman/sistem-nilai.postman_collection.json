          "request": {"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"refresh_token\": \"{{mhs1RefreshToken}}\"\n}","options":{"raw":{"language":"json"}}},"url":"{{base}}/auth/refresh"}
