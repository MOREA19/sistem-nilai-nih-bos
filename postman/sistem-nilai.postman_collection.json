          "request": {"method":"POST","header":[{"key":"X-Device-ID","value":"{{deviceMhs2}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"username\": \"{{usernameMhs2}}\",\n  \"password\": \"{{passwordMhs2}}\"\n}","options":{"raw":{"language":"json"}}},"url":"{{base}}/auth/login"}
